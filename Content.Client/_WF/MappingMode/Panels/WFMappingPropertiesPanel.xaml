<panels:WFMappingPropertiesPanel xmlns="https://spacestation14.io"
                                 xmlns:panels="clr-namespace:Content.Client._WF.MappingMode.Panels"
                                 Orientation="Vertical"
                                 HorizontalExpand="True"
                                 VerticalExpand="True">
    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
            <Label Text="{Loc 'wf-mapping-screen-section-selected'}" StyleClasses="LabelHeading" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <TextureRect Name="EntryIcon" SetSize="32 32" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Name="EntryName" ClipText="True" />
                    <Label Name="EntryId" ClipText="True" StyleClasses="LabelSubText" />
                </BoxContainer>
                <Button Name="QuickSelectButton" Disabled="True" Text="{Loc 'wf-mapping-screen-quick-select-star'}"
                        ToolTip="{Loc 'wf-mapping-screen-add-quick-select'}" TooltipDelay="0" />
            </BoxContainer>
            <Label Name="RotationLabel" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <OptionButton Name="PlacementModeMenu" HorizontalExpand="True"
                              ToolTip="{Loc 'entity-spawn-window-override-menu-tooltip'}" />
                <Button Name="ReplaceButton" ToggleMode="True"
                        Text="{Loc 'entity-spawn-window-replace-button-text'}" />
            </BoxContainer>

            <Label Text="{Loc 'wf-mapping-screen-section-mode'}" StyleClasses="LabelHeading" Margin="0 8 0 0" />
            <Label Name="ModeLabel" />
            <BoxContainer Name="EraseRow" Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{Loc 'wf-mapping-screen-erase-target'}" />
                <OptionButton Name="EraseTargetMenu" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Name="ShapeRow" Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{Loc 'wf-mapping-screen-shape-kind'}" />
                <OptionButton Name="ShapeKindMenu" HorizontalExpand="True" />
            </BoxContainer>

            <Label Text="{Loc 'wf-mapping-screen-section-levels'}" StyleClasses="LabelHeading" Margin="0 8 0 0" />
            <BoxContainer Name="LevelList" Orientation="Vertical" SeparationOverride="2" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="LevelUpButton" HorizontalExpand="True" Text="{Loc 'wf-mapping-tools-level-up'}" />
                <Button Name="LevelDownButton" HorizontalExpand="True" Text="{Loc 'wf-mapping-tools-level-down'}" />
            </BoxContainer>

            <Label Text="{Loc 'wf-mapping-screen-section-session'}" StyleClasses="LabelHeading" Margin="0 8 0 0" />
            <Label Name="SessionLabel" ClipText="True" />
            <Label Name="LimitsLabel" StyleClasses="LabelSubText" />
        </BoxContainer>
    </ScrollContainer>
</panels:WFMappingPropertiesPanel>
