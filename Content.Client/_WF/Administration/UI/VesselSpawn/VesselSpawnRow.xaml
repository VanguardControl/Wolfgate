<ContainerButton xmlns="https://spacestation14.io"
                 ToggleMode="True"
                 StyleClasses="ButtonSquare"
                 HorizontalExpand="True"
                 Margin="0 1">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 2">
        <Label Name="NameLabel"
               HorizontalExpand="True"
               ClipText="True" />
        <Label Name="SizeLabel"
               StyleClasses="LabelSubText"
               Margin="4 0" />
        <Label Name="PriceLabel"
               StyleClasses="LabelSubText"
               MinWidth="60"
               Align="Right" />
    </BoxContainer>
</ContainerButton>
