<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'wf-ghost-orbit-title'}"
                      MinSize="500 420"
                      SetSize="760 640">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="SearchBar" PlaceHolder="{Loc 'wf-ghost-orbit-search'}" HorizontalExpand="True" />
            <Button Name="MostFollowedButton" Text="{Loc 'ghost-target-window-warp-to-most-followed'}" />
            <Button Name="RefreshButton" Text="{Loc 'wf-ghost-orbit-refresh'}" />
            <CheckBox Name="AutoRefreshBox" Text="{Loc 'wf-ghost-orbit-auto-refresh'}" Pressed="True" />
        </BoxContainer>
        <Label Name="SummaryLabel" StyleClasses="LabelSubText" />
        <TabContainer Name="Pages" VerticalExpand="True">
            <ScrollContainer Name="Scroll" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="Sections" Orientation="Vertical" SeparationOverride="4" Margin="0 0 6 0" />
            </ScrollContainer>
            <ScrollContainer Name="EncounterScroll" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="EncounterBody" Orientation="Vertical" SeparationOverride="4" Margin="0 0 6 0">
                    <Label Name="EncountersEmpty" Text="{Loc 'wf-ghost-orbit-encounters-empty'}" StyleClasses="LabelSubText" />
                </BoxContainer>
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
