<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:goob="clr-namespace:Content.Client._Goobstation.Research.UI"
                      MinSize="900 560"
                      SetSize="1260 780"
                      Title="{Loc 'research-console-menu-title'}">
    <BoxContainer Orientation="Vertical" Margin="10" VerticalExpand="True" SeparationOverride="6">
        <!-- Server, points and discipline progress -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="StatusLabel" StyleClasses="LabelSubHeading"/>
                <RichTextLabel Name="PointsLabel"/>
            </BoxContainer>
            <BoxContainer Name="DisciplineContainer" Orientation="Horizontal" SeparationOverride="12" VerticalAlignment="Center"/>
            <Button Name="ServerButton" Text="{Loc 'research-console-menu-server-selection-button'}" VerticalAlignment="Center"/>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="8">
            <TabContainer Name="Tabs" HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="3">
                <!-- The Codex: the techweb, hunted node by node -->
                <BoxContainer Name="CodexTab" Orientation="Vertical" VerticalExpand="True">
                    <PanelContainer Name="TreeContainer" VerticalExpand="True" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#222226FF"/>
                        </PanelContainer.PanelOverride>
                        <goob:ResearchesContainerPanel Name="TreePanel"
                                                       HorizontalExpand="True"
                                                       VerticalExpand="True"
                                                       MouseFilter="Pass"
                                                       RectClipContent="True"/>
                        <Button Name="RecenterButton" Text="{Loc 'research-console-menu-recenter-button'}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"/>
                    </PanelContainer>
                    <BoxContainer Name="LegendContainer" Orientation="Horizontal" SeparationOverride="14" Margin="4 4 4 0"/>
                </BoxContainer>
                <!-- Relics: lost items outside the techweb -->
                <BoxContainer Name="RelicsTab" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6" Margin="4">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <LineEdit Name="SearchEdit" PlaceHolder="{Loc 'wf-blueprint-locator-search'}" HorizontalExpand="True"/>
                        <BoxContainer Name="TierFilters" Orientation="Horizontal" SeparationOverride="0"/>
                        <CheckBox Name="HideKnownBox" Text="{Loc 'wf-blueprint-locator-hide-known'}" VerticalAlignment="Center"/>
                        <Label Name="CountLabel" StyleClasses="LabelSecondaryColor" VerticalAlignment="Center"/>
                    </BoxContainer>
                    <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True" VerticalExpand="True">
                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Name="PatternList" Orientation="Vertical" Margin="4" SeparationOverride="2"/>
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>
            </TabContainer>

            <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="2">
                <ScrollContainer Name="DetailScroll" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="DetailPane" Orientation="Vertical" Margin="10" SeparationOverride="6">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                            <EntityPrototypeView Name="DetailIcon" Scale="2 2" MinSize="64 64" VerticalAlignment="Top"/>
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                                <Label Name="DetailName" StyleClasses="LabelHeading"/>
                                <Label Name="DetailTier" StyleClasses="LabelSecondaryColor"/>
                            </BoxContainer>
                        </BoxContainer>
                        <RichTextLabel Name="DetailDescription"/>
                        <RichTextLabel Name="DetailState"/>
                        <Button Name="DetailToggleButton" HorizontalAlignment="Left"/>
                        <Label Name="DetailRecipesHeader" Text="{Loc 'wf-blueprint-locator-prints'}" StyleClasses="LabelKeyText" Margin="0 6 0 0"/>
                        <BoxContainer Name="DetailRecipes" Orientation="Vertical" SeparationOverride="4"/>
                        <BoxContainer Name="DetailUnlocks" Orientation="Vertical" SeparationOverride="2"/>
                    </BoxContainer>
                </ScrollContainer>
                <Label Name="DetailEmpty" Text="{Loc 'wf-blueprint-locator-pick-one'}" StyleClasses="LabelSecondaryColor"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </PanelContainer>
        </BoxContainer>

        <!-- Hunt bar: the request being built, or the running hunt -->
        <PanelContainer StyleClasses="AngleRect">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
                <BoxContainer Name="RequestBar" Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="{Loc 'wf-blueprint-locator-request'}" StyleClasses="LabelKeyText" VerticalAlignment="Center"/>
                    <BoxContainer Name="RequestChips" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4"/>
                    <Label Name="FeeLabel" VerticalAlignment="Center"/>
                    <Button Name="LocateButton" Text="{Loc 'wf-blueprint-locator-locate'}" StyleClasses="CreatorPrimary"/>
                </BoxContainer>
                <BoxContainer Name="HuntBar" Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="{Loc 'wf-blueprint-locator-hunt-header'}" StyleClasses="LabelKeyText" VerticalAlignment="Center"/>
                    <RichTextLabel Name="HuntLabel" HorizontalExpand="True" VerticalAlignment="Center"/>
                    <Button Name="AbandonButton" Text="{Loc 'wf-blueprint-locator-abandon'}"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
