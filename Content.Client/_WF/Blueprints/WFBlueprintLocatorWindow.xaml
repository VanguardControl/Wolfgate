<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="520 520"
                      Title="{Loc 'wf-blueprint-locator-title'}">
    <BoxContainer Orientation="Vertical" Margin="10" VerticalExpand="True">
        <Label Name="StatusLabel" StyleClasses="LabelSubHeading" Margin="0 0 0 6"/>
        <PanelContainer StyleClasses="AngleRect" Margin="0 0 0 8">
            <BoxContainer Orientation="Vertical" Margin="8">
                <Label Text="{Loc 'wf-blueprint-locator-hunt-header'}" StyleClasses="LabelSubHeading"/>
                <RichTextLabel Name="HuntLabel"/>
                <Button Name="AbandonButton" Text="{Loc 'wf-blueprint-locator-abandon'}" HorizontalAlignment="Right"/>
            </BoxContainer>
        </PanelContainer>
        <Label Text="{Loc 'wf-blueprint-locator-patterns-header'}" StyleClasses="LabelSubHeading"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="PatternList" Orientation="Vertical"/>
        </ScrollContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <Label Name="FeeLabel" HorizontalExpand="True"/>
            <Button Name="LocateButton" Text="{Loc 'wf-blueprint-locator-locate'}"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
