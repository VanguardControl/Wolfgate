<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'fabrication-silo-title'}" MinSize="560 480" SetSize="660 680">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="KindLabel" StyleClasses="LabelHeading" />
        <RichTextLabel Name="HintLabel" />
        <Label Text="{Loc 'fabrication-silo-machines'}" StyleClasses="LabelKeyText" />
        <ScrollContainer VerticalExpand="True" SizeFlagsStretchRatio="2" HScrollEnabled="False" RectClipContent="True" MinHeight="120">
            <BoxContainer Name="ClientList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
        </ScrollContainer>
        <Label Name="StockLabel" StyleClasses="LabelHeading" />
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'fabrication-silo-search'}" />
        <ScrollContainer VerticalExpand="True" SizeFlagsStretchRatio="3" HScrollEnabled="False" RectClipContent="True" MinHeight="160">
            <BoxContainer Name="StockList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
