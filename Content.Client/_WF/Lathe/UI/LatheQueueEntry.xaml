<PanelContainer xmlns="https://spacestation14.io"
                StyleClasses="AngleRect"
                HorizontalExpand="True">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5" SeparationOverride="4">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="7">
            <Label Name="NumberLabel" MinWidth="24" VerticalAlignment="Center" />
            <BoxContainer Name="RecipeDisplayContainer" MinSize="32 32" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                <RichTextLabel Name="RecipeName" HorizontalExpand="True" />
                <Label Name="StatusLabel" StyleClasses="LabelSubText" />
            </BoxContainer>
        </BoxContainer>
        <RichTextLabel Name="MissingLabel" HorizontalExpand="True" Margin="6 0" Visible="False" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'lathe-menu-job-progress'}"
                   StyleClasses="LabelSubText"
                   HorizontalExpand="True"
                   VerticalAlignment="Center" />
            <Label Name="PrintedLabel" VerticalAlignment="Center" />
            <LineEdit Name="AmountEdit" MinWidth="58" MaxWidth="58" VerticalAlignment="Center" />
            <Button Name="CancelButton"
                    Text="{Loc 'lathe-menu-queue-cancel'}"
                    ToolTip="{Loc 'lathe-menu-cancel-job'}"
                    StyleClasses="Caution"
                    VerticalAlignment="Center" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
