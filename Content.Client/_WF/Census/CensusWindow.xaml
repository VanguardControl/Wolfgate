<controls:CensusWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._WF.Census"
    SetSize="540 640"
    MinSize="440 440"
    Title="{Loc 'wf-census-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Name="ListBox" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6">
            <Label Name="ListNote" Text="{Loc 'wf-census-list-loading'}" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="CensusList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10" />
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer Name="FormBox" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6" Visible="False">
            <Button Name="BackButton" Text="{Loc 'wf-census-back'}" HorizontalAlignment="Left" />
            <RichTextLabel Name="FormTitle" />
            <RichTextLabel Name="FormDescription" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="QuestionList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="14" Margin="0 0 8 0" />
            </ScrollContainer>
            <RichTextLabel Name="RequiredNote" />
            <Button Name="SubmitButton" Text="{Loc 'wf-census-submit'}" />
        </BoxContainer>
        <RichTextLabel Name="StatusLabel" />
    </BoxContainer>
</controls:CensusWindow>
