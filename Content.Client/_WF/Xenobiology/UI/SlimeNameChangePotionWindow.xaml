<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'slime-name-change-potion-ui-header'}"
                      SetWidth="400"
                      MinWidth="150">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="4">
        <Label Text="{Loc 'slime-name-change-potion-current-text-label'}" />
        <LineEdit Name="NameLineEdit" />
        <BoxContainer Orientation="Horizontal" Align="Center">
            <Button Name="ResetButton" Text="{Loc 'slime-name-change-potion-ui-reset-label-text'}" StyleClasses="OpenRight" />
            <Button Name="ClearButton" Text="{Loc 'slime-name-change-potion-ui-clear-label-text'}" StyleClasses="OpenLeft" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
