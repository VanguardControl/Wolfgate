<nanoChat:NanoChatUiFragment
    xmlns="https://spacestation14.io"
    xmlns:nanoChat="clr-namespace:Content.Client._WF.NanoChat"
    xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical"
    HorizontalExpand="True"
    VerticalExpand="True"
    Margin="5">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <controls:StripeBack MinSize="48 48"
                             VerticalExpand="False">
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True">
                <TextureRect TexturePath="/Textures/_WF/NanoChat/Icons/colotalk_logo.png"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             MinSize="32 32"
                             Margin="8 0 0 0" />
                <Label Text="{Loc nano-chat-title}"
                       StyleClasses="LabelHeading"
                       HorizontalExpand="True"
                       Margin="8 0"
                       VerticalAlignment="Center" />
                <Label Name="OwnNumberLabel"
                       Text="#0000"
                       StyleClasses="LabelSubText"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0" />
                <Button Name="MuteButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 4 0"
                        ToolTip="{Loc nano-chat-toggle-mute}">
                    <Control HorizontalExpand="True" VerticalExpand="True">
                        <TextureRect Name="BellIcon"
                                     TexturePath="/Textures/_WF/NanoChat/Icons/bell.svg.png"
                                     Stretch="KeepAspectCentered"
                                     MinSize="18 18" />
                        <TextureRect Name="BellMutedIcon"
                                     TexturePath="/Textures/_WF/NanoChat/Icons/bell_muted.png"
                                     Stretch="KeepAspectCentered"
                                     Visible="False"
                                     MinSize="18 18" />
                    </Control>
                </Button>
                <Button Name="NewChatButton"
                        Text="+"
                        MinSize="32 32"
                        MaxSize="32 32"
                        Margin="0 0 4 0"
                        StyleClasses="OpenBoth"
                        ToolTip="{Loc nano-chat-new-chat}" />
                <Button Name="NewGroupButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 4 0"
                        ToolTip="{Loc nano-chat-new-group}">
                    <TextureRect TexturePath="/Textures/Interface/VerbIcons/group.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <Button Name="LookupButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 4 0"
                        ToolTip="{Loc nano-chat-look-up}">
                    <TextureRect TexturePath="/Textures/Interface/VerbIcons/examine.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
            </BoxContainer>
        </controls:StripeBack>

        <BoxContainer Name="ChatView"
                      Orientation="Horizontal"
                      VerticalExpand="True"
                      HorizontalExpand="True"
                      Margin="0 5 0 0">
            <PanelContainer StyleClasses="AngleRect"
                            VerticalExpand="True"
                            MaxWidth="150">
                <ScrollContainer VerticalExpand="True"
                                 MinWidth="145"
                                 HorizontalExpand="True"
                                 HScrollEnabled="False">
                    <BoxContainer Name="ChatList"
                                  Orientation="Vertical"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  Margin="4">
                        <Label Name="NoChatsLabel"
                               Text="{Loc nano-chat-no-chats}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               StyleClasses="LabelSubText" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>

            <customControls:VSeparator Margin="3 0" />

            <PanelContainer StyleClasses="AngleRect"
                            VerticalExpand="True"
                            HorizontalExpand="True">
                <BoxContainer Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  Margin="0 0 0 4">
                        <Label Name="CurrentChatName"
                               Text="{Loc nano-chat-select-chat}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               VerticalExpand="True" />
                        <Label Name="ChatHeaderLabel"
                               StyleClasses="LabelHeading"
                               Align="Center"
                               ClipText="True"
                               Margin="4 2"
                               Visible="False" />
                        <ScrollContainer Name="MessagesScroll"
                                         VerticalExpand="True"
                                         HorizontalExpand="True"
                                         Visible="False">
                            <BoxContainer Name="MessageList"
                                          Orientation="Vertical"
                                          VerticalExpand="True"
                                          HorizontalExpand="True" />
                        </ScrollContainer>
                    </BoxContainer>

                    <Label Name="CharacterCount"
                           HorizontalAlignment="Center"
                           StyleClasses="LabelSubText"
                           Margin="0 0 4 2"
                           Visible="False" />
                    <BoxContainer Name="MessageInputContainer"
                                  Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  Margin="0 4 0 0"
                                  Visible="False">
                        <Button Name="MembersButton"
                                MaxSize="32 32"
                                Visible="False"
                                StyleClasses="OpenBoth"
                                Margin="0 0 4 0"
                                ToolTip="{Loc nano-chat-group-members}">
                            <TextureRect TexturePath="/Textures/Interface/VerbIcons/group.svg.192dpi.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="18 18" />
                        </Button>
                        <Button Name="EditChatButton"
                                MaxSize="32 32"
                                Visible="False"
                                StyleClasses="OpenBoth"
                                Margin="0 0 4 0"
                                ToolTip="{Loc nano-chat-edit}">
                            <TextureRect TexturePath="/Textures/_WF/NanoChat/Icons/edit.svg.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="18 18" />
                        </Button>
                        <Button Name="DeleteChatButton"
                                MaxSize="32 32"
                                Visible="False"
                                StyleClasses="OpenBoth"
                                Margin="0 0 4 0"
                                ToolTip="{Loc nano-chat-delete}">
                            <TextureRect TexturePath="/Textures/Interface/VerbIcons/delete_transparent.svg.192dpi.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="18 18" />
                        </Button>
                        <Button Name="MuteChatButton"
                                MaxSize="32 32"
                                StyleClasses="OpenBoth"
                                Margin="0 0 4 0"
                                ToolTip="{Loc nano-chat-toggle-mute-chat}">
                            <Control HorizontalExpand="True" VerticalExpand="True">
                                <TextureRect Name="BellIconContact"
                                             TexturePath="/Textures/_WF/NanoChat/Icons/bell.svg.png"
                                             Stretch="KeepAspectCentered"
                                             MinSize="18 18" />
                                <TextureRect Name="BellMutedIconContact"
                                             TexturePath="/Textures/_WF/NanoChat/Icons/bell_muted.png"
                                             Stretch="KeepAspectCentered"
                                             Visible="False"
                                             MinSize="18 18" />
                            </Control>
                        </Button>
                        <OptionButton Name="EffectButton"
                                      StyleClasses="OpenBoth"
                                      Margin="0 0 4 0"
                                      ToolTip="{Loc nano-chat-effect}" />
                        <Button Name="SubtleButton"
                                MaxSize="32 32"
                                ToggleMode="True"
                                StyleClasses="OpenBoth"
                                Margin="0 0 4 0"
                                ToolTip="{Loc nano-chat-subtle}">
                            <TextureRect TexturePath="/Textures/Interface/VerbIcons/lock.svg.192dpi.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="18 18" />
                        </Button>
                        <LineEdit Name="MessageInput"
                                  PlaceHolder="{Loc nano-chat-message-placeholder}"
                                  HorizontalExpand="True"
                                  StyleClasses="OpenRight" />
                        <Button Name="SendButton"
                                MinSize="32 32"
                                Disabled="True"
                                StyleClasses="OpenLeft"
                                Margin="4 0 0 0"
                                ToolTip="{Loc nano-chat-send}">
                            <TextureRect TexturePath="/Textures/Interface/Nano/triangle_right.png"
                                         Stretch="KeepAspectCentered" />
                        </Button>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <nanoChat:NanoChatLookupView Name="LookupView"
                                     Visible="False" />
    </BoxContainer>
</nanoChat:NanoChatUiFragment>
