<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:radar="clr-namespace:Content.Client._WF.Administration.UI.AdminRadar"
                      xmlns:godpanel="clr-namespace:Content.Client._WF.GodPanel.UI"
                      Title="{Loc 'wf-godpanel-title'}"
                      SetSize="1400 860"
                      MinSize="900 600">
    <BoxContainer Orientation="Vertical">
        <godpanel:WFGodPanelTopBar Name="TopBar" />
        <PanelContainer StyleClasses="LowDivider" />
        <SplitContainer Name="MainSplit" Orientation="Vertical" SplitWidth="6" VerticalExpand="True" HorizontalExpand="True">
            <SplitContainer Name="TopSplit" Orientation="Horizontal" SplitWidth="6" VerticalExpand="True" HorizontalExpand="True">
                <godpanel:WFGodRosterControl Name="Roster" />
                <SplitContainer Name="CentreSplit" Orientation="Horizontal" SplitWidth="6" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" MinSize="300 200">
                        <WrapContainer Name="MapToggles" Margin="4 2">
                            <Button Name="IffToggle"
                                    Text="{Loc 'shuttle-console-iff-toggle-short'}"
                                    StyleClasses="ButtonSquare"
                                    ToggleMode="True"
                                    Pressed="True" />
                            <Button Name="IffDetailedToggle"
                                    Text="{Loc 'shuttle-console-iff-detailed-short'}"
                                    StyleClasses="ButtonSquare"
                                    ToggleMode="True"
                                    Pressed="True" />
                            <Button Name="TrueIffToggle"
                                    Text="{Loc 'wf-admin-radar-true-iff'}"
                                    ToolTip="{Loc 'wf-admin-radar-true-iff-tooltip'}"
                                    StyleClasses="ButtonSquare"
                                    ToggleMode="True" />
                            <Button Name="PlayersToggle"
                                    Text="{Loc 'wf-admin-radar-players'}"
                                    ToolTip="{Loc 'wf-admin-radar-players-tooltip'}"
                                    StyleClasses="ButtonSquare"
                                    ToggleMode="True" />
                            <Button Name="TeleportToggle"
                                    Text="{Loc 'wf-radar-teleport-toggle'}"
                                    ToolTip="{Loc 'wf-radar-teleport-tooltip'}"
                                    StyleClasses="ButtonSquare"
                                    ToggleMode="True" />
                            <Button Name="RecentreButton"
                                    Text="{Loc 'wf-godpanel-map-recentre'}"
                                    ToolTip="{Loc 'wf-godpanel-map-recentre-tooltip'}"
                                    StyleClasses="ButtonSquare" />
                        </WrapContainer>
                        <!-- The nav control adds its mode buttons to a LayoutContainer parent -->
                        <LayoutContainer Name="MapHost" VerticalExpand="True" HorizontalExpand="True" RectClipContent="True">
                            <radar:AdminRadarControl Name="RadarScreen" />
                        </LayoutContainer>
                        <godpanel:WFGodContextControl Name="Context" />
                    </BoxContainer>
                    <godpanel:WFGodFeedsControl Name="Feeds" />
                </SplitContainer>
            </SplitContainer>
            <godpanel:WFGodTimelineControl Name="Timeline" />
        </SplitContainer>
    </BoxContainer>
</controls:FancyWindow>
