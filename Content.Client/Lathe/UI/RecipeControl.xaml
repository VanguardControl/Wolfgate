<Control xmlns="https://spacestation14.io" HorizontalExpand="True" MinHeight="58">
    <Button Name="Button" HorizontalExpand="True" StyleClasses="ButtonSquare">
        <BoxContainer Orientation="Horizontal" Margin="6 4" SeparationOverride="10">
            <BoxContainer Name="RecipeDisplayContainer" MinSize="32 32" MaxSize="32 32" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="3">
                <Label Name="RecipeName" HorizontalExpand="True" ClipText="True" />
                <Label Name="AvailabilityLabel" StyleClasses="LabelSubText" HorizontalExpand="True" ClipText="True" />
            </BoxContainer>
            <Label Text="+" StyleClasses="LabelHeading" VerticalAlignment="Center" Margin="6 0" />
        </BoxContainer>
    </Button>
</Control>
