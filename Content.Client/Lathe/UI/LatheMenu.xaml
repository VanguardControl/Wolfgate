    <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" SeparationOverride="10" Margin="8">
        <!-- Recipe browser -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" SizeFlagsStretchRatio="5" SeparationOverride="6">
            <Label Text="{Loc 'lathe-menu-recipes-title'}" StyleClasses="LabelHeading" />
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#35424b" BackgroundColor="#151b21" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="6" SeparationOverride="6">
                    <LineEdit Name="SearchBar" PlaceHolder="{Loc 'lathe-menu-search-designs'}" HorizontalExpand="True" />
                    <OptionButton Name="FilterOption" MinWidth="145" StyleClasses="ButtonSquare" />
                </BoxContainer>
            </PanelContainer>
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" RectClipContent="True">
                <BoxContainer Name="RecipeList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
            </ScrollContainer>
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#35424b" BackgroundColor="#151b21" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="7" SeparationOverride="5">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                        <Label Text="{Loc 'lathe-menu-amount'}" VerticalAlignment="Center" />
                        <LineEdit Name="AmountLineEdit" Text="1" PlaceHolder="1" HorizontalExpand="True" />
                        <Label Text="{Loc 'lathe-menu-quantity-hint'}" StyleClasses="LabelSubText" VerticalAlignment="Center" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="12">
                        <CheckBox Name="LoopCheckbox" HorizontalExpand="True" Text="{Loc 'lathe-menu-loop'}" />
                        <CheckBox Name="SkipCheckbox" HorizontalExpand="True" Text="{Loc 'lathe-menu-skip'}" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Work queue and linked supplies -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" SizeFlagsStretchRatio="5" SeparationOverride="8">
            <PanelContainer VerticalExpand="True" SizeFlagsStretchRatio="3">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#35424b" BackgroundColor="#151b21" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Text="{Loc 'lathe-menu-queue-title'}" StyleClasses="LabelHeading" HorizontalExpand="True" VerticalAlignment="Center" />
                        <Button Name="ServerListButton" Access="Public" Text="{Loc 'lathe-menu-server-list'}" StyleClasses="ButtonSquare OpenRight" />
                    </BoxContainer>
                    <PanelContainer Name="FabricatingContainer" Visible="False">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#397e72" BackgroundColor="#1a302e" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Horizontal" Margin="7" SeparationOverride="8">
                            <Label Text="{Loc 'lathe-menu-status-printing'}" StyleClasses="LabelHeading" VerticalAlignment="Center" />
                            <BoxContainer Name="FabricatingDisplayContainer" MinSize="32 32" />
                            <Label Name="NameLabel" ClipText="True" HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False" RectClipContent="True" MinHeight="180">
                        <BoxContainer Name="QueueList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer VerticalExpand="True" SizeFlagsStretchRatio="2">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#35424b" BackgroundColor="#151b21" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="8" SeparationOverride="5">
                    <Label Text="{Loc 'lathe-menu-supplies-title'}" StyleClasses="LabelHeading" />
                    <wf:LatheSupplyStatus Name="SupplyStatus" />
                    <ui:MaterialStorageControl Name="MaterialsList" VerticalExpand="True" HorizontalExpand="True" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
