<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:style="clr-namespace:Content.Client.Stylesheets"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         VerticalExpand="True">
    <Control>
        <PanelContainer Name="BackgroundPanel" />
        <BoxContainer Orientation="Vertical" SeparationOverride="0">
            <!-- WOLFGATE START: creator header laid out like a game-menu sub-screen; control names unchanged -->
            <BoxContainer Orientation="Horizontal" Margin="24 14 24 8" SeparationOverride="6">
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}" StyleClasses="LobbyTitle" VAlign="Center" />
                <Control HorizontalExpand="True" />
                <Button Name="StatsButton" Text="{Loc 'character-setup-gui-character-setup-stats-button'}" StyleClasses="ButtonBig" />
                <cc:CommandButton Name="AdminRemarksButton" Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}" StyleClasses="ButtonBig" />
                <Button Name="RulesButton" Text="{Loc 'character-setup-gui-character-setup-rules-button'}" StyleClasses="ButtonBig" />
                <Button Name="CloseButton" Access="Public" Text="{Loc 'character-setup-gui-character-setup-close-button'}" StyleClasses="ButtonBig" />
            </BoxContainer>
            <!-- WOLFGATE END -->
            <!-- WOLFGATE START: gold divider replaced by HighDivider -->
            <!--
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            -->
            <PanelContainer StyleClasses="HighDivider" Margin="24 0" />
            <!-- WOLFGATE END -->
            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="0">
                <!-- WOLFGATE START: slot list in a titled card, was a bare ScrollContainer -->
                <PanelContainer StyleClasses="CreatorCard" MinWidth="320" Margin="24 12 0 12">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6">
                        <Label Text="{Loc 'wf-creator-slots'}" StyleClasses="CreatorHeading" />
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer Name="Characters" Orientation="Vertical" SeparationOverride="4" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
                <!-- WOLFGATE END -->
                <!-- WOLFGATE START: no divider beside the slot card -->
                <!--
                <PanelContainer MinSize="2 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                -->
                <!-- WOLFGATE END -->
                <BoxContainer Name="CharEditor" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </Control>
</Control>
