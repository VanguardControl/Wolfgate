<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <!-- WOLFGATE(Stylesheets) START: hero layout for the game-menu lobby; control names unchanged -->
    <!-- Replaced flat ViewBox/VSpacer/Button list:
    <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalAlignment="Center">

    </BoxContainer>
    <controls:VSpacer/>
    <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
            HorizontalAlignment="Center"
            Margin="0 5 0 0"/>
    -->
    <BoxContainer Name="VBox" Orientation="Vertical" HorizontalAlignment="Center">
        <controls:NanoHeading Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}" Visible="False" />
        <BoxContainer Name="Loaded" Orientation="Vertical" Visible="False" HorizontalAlignment="Center"
                      SeparationOverride="2" SetWidth="300">
            <PanelContainer StyleClasses="LobbyHero" HorizontalAlignment="Center">
                <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalAlignment="Center" Margin="28 20" />
            </PanelContainer>
            <RichTextLabel Name="Summary" HorizontalAlignment="Center" StyleClasses="LobbyHeroName" Margin="0 12 0 0" />
            <!-- Frontier -->
            <Label Name="BankBalance" HorizontalAlignment="Center" StyleClasses="LobbyHeroText" />
            <!-- Company Display -->
            <RichTextLabel Name="Company" HorizontalAlignment="Center" StyleClasses="LobbyHeroText" />
            <!-- End Frontier -->
            <!-- MonoCoins Display -->
            <Label Name="MonoCoins" HorizontalAlignment="Center" StyleClasses="LobbyHeroText" />
            <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                    HorizontalAlignment="Center" Margin="0 12 0 0" />
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" />
    </BoxContainer>
    <!-- WOLFGATE END -->
</Control>
