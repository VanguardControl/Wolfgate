<!-- WOLFGATE(Wolfmed): HOOK 26 - the Wolfmed diagnostic panel's namespace (P4-D25, parallel panel). -->
<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:wolfmed="clr-namespace:Content.Client._WF.Wolfmed.Medical"
    SetHeight="600"
    SetWidth="900"
    MinSize="660 470"
    Resizable="True"> <!-- WOLFGATE(Wolfmed): HOOK 26 - was a fixed 350x650 column; the two-pane split needs width and a user resize. -->
    <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#525252" BackgroundColor="#3d474d"/>
        </PanelContainer.PanelOverride>
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="2 2 2 2">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#181818"/>
            </PanelContainer.PanelOverride>
        <BoxContainer
            Name="RootContainer"
            VerticalExpand="True"
            Orientation="Vertical"
            Margin="2">
            <Label
                Name="NoPatientDataText"
                Text="{Loc health-analyzer-window-no-patient-data-text}"/>
            <!-- WOLFGATE(Wolfmed): HOOK 26 - two-pane split; the static overview on the left, the Wolfmed tabs on the right. -->
            <BoxContainer
                Name="WolfmedPaneSplit"
                Orientation="Horizontal"
                VerticalExpand="True"
                HorizontalExpand="True">
            <BoxContainer
                Name="WolfmedOverviewPane"
                Orientation="Vertical"
                VerticalExpand="True"
                MinWidth="330">
            <!-- Shitmed Change Start -->
            <!-- WOLFGATE(Wolfmed): UI3 - the return button and its frame are gone; the doll no longer switches to a
                 per-part scan, it sets the player's targeted body part. -->
            <!-- Shitmed Change End -->
            <BoxContainer
                Name="PatientDataContainer"
                Margin="1 1"
                Orientation="Vertical">
                <!-- Shitmed Change Start -->
                    <PanelContainer VerticalExpand="False" HorizontalExpand="True" Margin="2 2 2 2">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#181818"/>
                        </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal"
                              Margin="0 0 0 5">
                    <PanelContainer VerticalExpand="False" HorizontalExpand="False" Margin="2 2">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                        </PanelContainer.PanelOverride>
                        <PanelContainer VerticalExpand="False" HorizontalExpand="False" Margin="1 1">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                            </PanelContainer.PanelOverride>
                    <!-- WOLFGATE(Wolfmed): one fixed 96x96 frame for the doll AND its buttons. Unsized, this panel stretched to the
                         row height: the SpriteView stayed centred in it while PartView sat at its bottom-left, so every
                         hover and selection highlight landed below and left of the limb. -->
                    <PanelContainer SetSize="96 96" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextureRect Name="NoDataTex"
                                     Access="Public"
                                     SetSize="96 96"
                                     Visible="false"
                                     Stretch="KeepAspectCentered"
                                     TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png"/>
                        <SpriteView OverrideDirection="South"
                                    Scale="1.0 1.0"
                                    Name="SpriteView"
                                    Access="Public"
                                    SetSize="96 96"/>
<!-- WOLFGATE(Wolfmed): every button is placed from its limb's pixel bounds in the status doll art
                             (_Shitmed/Interface/Targeting/Status/<part>.rsi, 32 px drawn at 3x): one art pixel of
                             margin all round, which is the hover texture's outline. Shitmed's nested 2.5x layout and
                             the HUD doll's layout both belong to different art and sat off these limbs.
                             WolfmedAnalyzerDollLayoutTest measures this. -->
                        <PanelContainer
                            Name="PartView"
                            SetSize="96 96">
                            <TextureButton
                                Name="HeadButton"
                                SetSize="27 27"
                                Margin="33 6 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonHead"/>
                            <TextureButton
                                Name="ChestButton"
                                SetSize="33 27"
                                Margin="30 27 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonChest"/>
                            <TextureButton
                                Name="GroinButton"
                                SetSize="33 21"
                                Margin="30 48 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonGroin"/>
                            <TextureButton
                                Name="RightArmButton"
                                SetSize="21 24"
                                Margin="18 27 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonRightArm"/>
                            <TextureButton
                                Name="RightHandButton"
                                SetSize="18 18"
                                Margin="18 45 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonRightHand"/>
                            <TextureButton
                                Name="LeftArmButton"
                                SetSize="21 24"
                                Margin="54 27 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonLeftArm"/>
                            <TextureButton
                                Name="LeftHandButton"
                                SetSize="18 18"
                                Margin="57 45 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonLeftHand"/>
                            <TextureButton
                                Name="RightLegButton"
                                SetSize="18 24"
                                Margin="30 57 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonRightLeg"/>
                            <TextureButton
                                Name="RightFootButton"
                                SetSize="24 15"
                                Margin="24 75 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonRightFoot"/>
                            <TextureButton
                                Name="LeftLegButton"
                                SetSize="18 24"
                                Margin="45 57 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonLeftLeg"/>
                            <TextureButton
                                Name="LeftFootButton"
                                SetSize="24 15"
                                Margin="45 75 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                StyleClasses="TargetDollButtonLeftFoot"/>
                        </PanelContainer>
                    </PanelContainer>
                    </PanelContainer>
                </PanelContainer>
                    <BoxContainer Orientation="Vertical"
                                  HorizontalExpand="True">
                        <RichTextLabel Name="NameLabel"
                                       SetWidth="150" HorizontalAlignment="Left"/>
                        <Label Name="SpeciesLabel"
                               VerticalAlignment="Top"
                               StyleClasses="LabelSubText"
                               HorizontalAlignment="Left"/>
                        <Label Name="PartNameLabel"
                               VerticalAlignment="Bottom"
                               StyleClasses="LabelSubText"
                               HorizontalAlignment="Left"/>
                    <Label Margin="0 0 5 0"
                           HorizontalExpand="True"
                           HorizontalAlignment="Right"
                           VerticalExpand="True"
                           VerticalAlignment="Bottom"
                           Name="ScanModeLabel"
                           Text="{Loc 'health-analyzer-window-entity-unknown-text'}"/>
                    </BoxContainer>
                </BoxContainer>
                    </PanelContainer>

                <PanelContainer StyleClasses="LowDivider"/>

                <PanelContainer VerticalExpand="False" HorizontalExpand="True" Margin="4 4 4 4">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                    </PanelContainer.PanelOverride>
                    <PanelContainer VerticalExpand="False" HorizontalExpand="True" Margin="4 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                        </PanelContainer.PanelOverride>
                <GridContainer Margin="2 2"
                               Columns="2">
                    <Label Text="{Loc 'health-analyzer-window-entity-status-text'}"/>
                    <Label Name="StatusLabel"
                           FontColorOverride="#ff9100"/>
                    <Label Text="{Loc 'health-analyzer-window-entity-temperature-text'}"/>
                    <Label Name="TemperatureLabel"
                           FontColorOverride="#ff9100"/>
                    <Label Text="{Loc 'health-analyzer-window-entity-blood-level-text'}"/>
                    <Label Name="BloodLabel"
                           FontColorOverride="#ff9100"/>
                    <Label Text="{Loc 'health-analyzer-window-entity-damage-total-text'}"/>
                    <Label Name="DamageLabel"
                           FontColorOverride="#ff9100"/>
                </GridContainer>
                    </PanelContainer>
                </PanelContainer>
            </BoxContainer>

            <PanelContainer Name="AlertsDivider"
                            Visible="False"
                            StyleClasses="LowDivider"/>

            <!-- WOLFGATE(Wolfmed): HOOK 26 - named so the alert box no longer eats 62px of the overview pane when there is nothing to warn about. -->
            <PanelContainer Name="WolfmedAlertsPanel" Visible="False" VerticalExpand="False" HorizontalExpand="True" Margin="4 4 4 4" SetHeight="62">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                </PanelContainer.PanelOverride>
                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer
                        Margin="5 5 5 5"
                        ReturnMeasure="True"
                        VerticalExpand="True">
            <BoxContainer Name="AlertsContainer"
                          Visible="False"
                          Margin="0 0"
                          Orientation="Vertical"
                          HorizontalAlignment="Center">

            </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="LowDivider"/>
            <!-- Shitmed Change End -->
            <PanelContainer Name="WolfmedDamageGroupsPanel" VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                </PanelContainer.PanelOverride>
                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                    </PanelContainer.PanelOverride>
            <ScrollContainer
                Margin="5 5 5 5"
                ReturnMeasure="True"
                VerticalExpand="True">
            <BoxContainer
                Name="GroupsContainer"
                Margin="0 5 0 5"
                Orientation="Vertical">
            </BoxContainer>
            </ScrollContainer>
                </PanelContainer>
            </PanelContainer>
            </BoxContainer>
            <!-- WOLFGATE(Wolfmed): HOOK 26 - the parallel Wolfmed diagnostic panel (P4-D25); the right pane, hidden for non-wound-hosts. -->
            <wolfmed:WolfmedDiagnosticPanel Name="WolfmedPanel"
                                            Visible="False"
                                            HorizontalExpand="True"
                                            VerticalExpand="True"/>
            </BoxContainer>
            <!-- WOLFGATE(Wolfmed): HOOK 26 - two-pane split end. -->

        </BoxContainer>
        </PanelContainer>
    </PanelContainer>
</controls:FancyWindow>
