wf-cockpit-velocity = VELOCITY
wf-cockpit-velocity-forward = FWD
wf-cockpit-velocity-aft = AFT
wf-cockpit-velocity-port = P
wf-cockpit-velocity-starboard = S
wf-cockpit-velocity-help = Actual ship motion relative to its bow: forward up, aft down, port left, starboard right. The arrow shows drift direction and grows with speed up to 100 m/s; the readout shows exact speed. A centered dot means stopped. This does not follow the camera.
wf-cockpit-speedometer = SPEEDOMETER
wf-cockpit-speedometer-help = Actual ship speed in metres per second. The scale starts at 0–100 m/s and expands for higher speeds.
