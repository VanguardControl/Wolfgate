## Chunk
wf-chunk-examine = A slab of planetary crust roughly { $radius } tiles across, cut from { $planet }.
wf-chunk-no-cracker = This chunk's cracker no longer exists.

## Evacuation (F7)
wf-chunk-evac-announce = EVACUATE. This chunk is being released and will fall in { $seconds } seconds.
wf-chunk-evac-popup = EVACUATE THE CHUNK
wf-chunk-evac-warning = Chunk release in { $seconds } seconds.
wf-chunk-evac-orphan = EVACUATE. This chunk has lost its cracker and is falling now.

## wfcracker command
cmd-wfcracker-extracted = Extracted { $grid }.
cmd-wfcracker-dropped = Dropped { $grid } back into transit.
cmd-wfcracker-no-chunk = That cracker has no extracted chunk.
cmd-wfcracker-extract-failed = Extraction failed: { $reason }
