## M1b: burns and caps (plan §3.7, OD11, OD12).

# A charred hand, foot, arm or leg that kept burning falls away.
wolfmed-char-crumble = {CAPITALIZE(THE($part))} crumbles to ash!

# The patient, when their burns start losing fluid.
wolfmed-burn-fluid-start = Your burns are weeping fluid. Dress them; you will need fluids.

# The analyzer, beside the circulation line.
wolfmed-vitals-burn-fluid-slow = Fluid loss from burns: slow ({ $rate } u/s)
wolfmed-vitals-burn-fluid-fast = Fluid loss from burns: fast ({ $rate } u/s)

# Examine, close up.
wolfmed-look-weeping-burns-self = Your burns are weeping fluid.
wolfmed-look-weeping-burns-other = { CAPITALIZE(THE($target)) } has weeping burns.
