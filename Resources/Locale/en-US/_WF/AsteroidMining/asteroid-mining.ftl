tiles-wf-asteroid-core = asteroid core

wf-asteroid-examine-scan = Hold a mining laser on it and the gunnery console will scan what it holds.
wf-asteroid-name-metallic = metallic {$name}
wf-asteroid-examine-metallic = Its surface glints with exposed metal. It will take a lot of heat to crack.

wf-mining-gunnery-title = MINING LASER
wf-mining-gunnery-power = Power {$power}%
wf-mining-gunnery-power-help = Sets every mining laser on this ship. Hold the rock's heat in the green window: too little does nothing, the yellow band loses ore and red blows the rock up.
wf-mining-gunnery-power-up = +{$amount}
wf-mining-gunnery-power-down = -{$amount}
wf-mining-gunnery-lasers = {$count ->
    [one] 1 laser
    *[other] {$count} lasers
}
wf-mining-gunnery-cooldown = Overloaded: {$seconds} s
wf-mining-gunnery-idle = Fire on a rock to scan it.
wf-mining-gunnery-idle-help = Fire a mining laser at an asteroid to scan what it holds and watch its heat.
wf-mining-gunnery-rock = {CAPITALIZE($name)}, {$mass} veins
wf-mining-gunnery-ore = {CAPITALIZE($name)} {$percent}%
wf-mining-gunnery-inert = Plain rock {$percent}%
wf-mining-gunnery-resistance = Resistance {$percent}%
wf-mining-gunnery-heat = Heat {$charge}%, window {$low}-{$high}%
wf-mining-gunnery-meter-help = White needle: the rock's heat now. Hold it in the green window while firing to crack the rock; yellow loses ore and red past the line overcharges it. Heat settles slowly, so change the power a little at a time.
wf-mining-gunnery-progress = Crack progress
wf-mining-gunnery-yield = Yield {$percent}%
wf-mining-gunnery-yield-help = The share of the rock's ore a crack will keep. Cracking in the yellow band past the window is faster but loses ore.
wf-mining-gunnery-overcharge = OVERCHARGING!
wf-mining-gunnery-overcharge-help = The rock is past the red line. Lower the power or stop firing before it blows up.
