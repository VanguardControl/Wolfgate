ent-WFLuggageTug = luggage tug
    .desc = A small sit-on electric tug for pulling luggage trolleys. Buckle in to drive it.
ent-WFLuggageTrolley = luggage trolley
    .desc = A flatbed trolley that couples behind a luggage tug. Strap a crate to it.

wf-tug-examine-trolleys = It is towing {$count} of {$max} trolleys.

wf-trolley-verb-couple = Couple to tug
wf-trolley-verb-uncouple = Uncouple
wf-trolley-verb-load = Strap crate on
wf-trolley-verb-unload = Take crate off

wf-trolley-coupled = You couple the trolley.
wf-trolley-uncoupled = You uncouple the trolley.
wf-trolley-couple-full = The tug can't pull any more trolleys.
wf-trolley-couple-far = Move the trolley right behind the tug or the last trolley.
wf-trolley-moving = Stop the tug first.
wf-trolley-load-start = You start strapping the crate on.
wf-trolley-unload-start = You start unstrapping the crate.

wf-trolley-examine-coupled = It is coupled to a tug.
wf-trolley-examine-cargo = {CAPITALIZE(THE($cargo))} is strapped to it.
