wg-mentor-watch = Watch
wg-mentor-watch-prompt = A Mentor would like to watch what you see, to help you. Allow?
wg-mentor-watch-allow = Allow
wg-mentor-watch-deny = Not now
wg-mentor-watch-denied = They said not now.
wg-mentor-watch-active = A Mentor is watching.
wg-mentor-watch-stop = Stop watching
wg-mentor-watch-started = Watching { $character }. Press { $key } to return.
wg-mentor-watch-staff-start = { $mentor } started watching { $character }.
wg-mentor-watch-staff-end = { $mentor } stopped watching { $character }.
wg-mentor-watch-refused-trainee = Trainees can't step out yet. You can orbit as a ghost.
wg-mentor-watch-refused-danger = You can't step out while you're hurt, critical or restrained.
wg-mentor-watch-refused-antag = You can't step out while you hold an antagonist role.
wg-mentor-watch-refused-cooldown = Wait { $seconds } seconds before stepping out again.
wg-mentor-unbind = Stop following
wg-mentor-action-return = Return to body
wg-mentor-action-return-desc = Go back to your body.
wg-mentor-return-time = Time's up. You're back in your body.
wg-mentor-return-hurt = Your body was hurt, so you're back in it.
wg-mentor-return-closed = The question closed, so you're back in your body.
wg-mentor-return-withdrawn = They stopped the watch, so you're back in your body.
wg-mentor-away-examine = They're away helping someone.

ent-WGActionMentorReturn = { wg-mentor-action-return }
    .desc = { wg-mentor-action-return-desc }
ui-options-function-wg-mentor-return = { wg-mentor-action-return }

