guide-entry-wg-rule-conflict-seven-underground = Conflict Rule 7 - The Underground

# Heat
wg-underground-sender = The Underground
wg-underground-pda = UNDERGROUND: [color={$color}]{$level}[/color]
wg-underground-level-quiet = QUIET
wg-underground-level-watched = WATCHED
wg-underground-level-wanted = WANTED
wg-underground-level-raid = RAID
wg-underground-told-rising = Heat is up. We are {$level}.
wg-underground-told-falling = Heat is down. We are {$level}.
wg-underground-told-raid-closed = The raid window has closed. Anyone still shooting at the station is breaking the rules.
wg-underground-market-closed = The market is closed. No passes go out, and the Heat cools faster.
wg-underground-market-open = The market is open again.
wg-underground-lockdown-started = A raid window is open. The market is shut and the vend is locked until the lockdown after it ends.
wg-underground-lockdown-over = The lockdown is over. The Godfather can open the market again.
wg-underground-lockdown-refused = The market stays shut during a raid window and the lockdown after it.
wg-underground-vend-locked = The vend is locked down. Nothing is for sale until the lockdown ends.

wg-underground-intel-name = TSF Signals
wg-underground-intel-watched = Underground goods are moving through the sector. Watch the stations for smugglers.
wg-underground-intel-wanted = The Underground is running hot. We are working on a bearing to its station.
wg-underground-intel-bearing = Underground traffic bears {$bearing} degrees from the middle of the sector. No range yet.
wg-underground-intel-quiet = The Underground has gone quiet. We have lost the trail.

wg-underground-raid-sender = Sector Watch
wg-underground-raid-open = The Underground's station has been found at {$x}, {$y}. It can be struck for the next {$minutes} minutes.
wg-underground-raid-closed = The window on the Underground's station has closed. Break off and leave.

# Warrants and bail
wg-underground-captured = {$name} has been handed in to the TSF.
wg-underground-bail-somewhere = an unknown place
wg-underground-bail-told = {$name} is being held at {$place}. Bail is {$amount} thalers, and you have {$minutes} minutes to pay it at the cargo console.
wg-underground-bail-popup = The Underground has {$minutes} minutes to pay bail. The pallet won't take them until then.
wg-underground-bail-paid = Bail of {$amount} thalers has been paid for {$name}.
wg-underground-bail-paid-popup = Bail of {$amount} thalers has been paid. Let them go.
wg-underground-bail-failed = Bail can't be paid. They are no longer held, or the treasury is short.

# Heretic mark
wg-heretic-marked = The Sultanate has marked you a heretic. The Vanguard is paid to hand you over, dead or alive. They have to challenge you before they attack, and they can't hunt you in a Safe Zone.
wg-heretic-marked-popup = The Sultanate has marked you a heretic.

# Station
wg-underground-safehouse-name = Underground Safehouse
wg-underground-turrets-armed = The station's turrets are armed. They fire on anyone without our access.
wg-underground-turrets-warning = The station's turrets come up in {$seconds} seconds. They fire on anyone without Underground access. Guests, leave now.
wg-underground-turrets-closed = This station's turrets are up. They fire on anyone without Underground access that they can see, in a docked ship too. Undock and stand off.
wg-underground-turrets-down = The station's turrets are standing down.
wg-underground-turrets-raid = A raid window is open. The turrets stand down until it closes, then come back up with a warning.
wg-underground-turrets-refused = The turrets can't be armed while a raid window is open.
wg-underground-hop-told = The Godfather is moving the station. It jumps in {$seconds} seconds. Get aboard, or cast off if you are not coming.
wg-underground-hop-wait = The jump drive is recharging. It is ready in {$minutes} minutes.
wg-underground-hop-raid = The station can't jump while a raid window is open.
wg-underground-hop-jumping = The station is already jumping.
wg-underground-hop-failed = The jump drive won't engage.
wg-underground-hop-nowhere = The jump drive can't find clear space to jump to. Try again.
wg-underground-hop-aborted = A raid window has opened. The jump is off, and the drive is ready again.

# The cargo console's verbs
wg-underground-verb-status = Faction status
wg-underground-verb-pass = Issue a market pass
wg-underground-verb-bail = Pay bail for {$name} ({$amount} thalers)
wg-underground-verb-open = Open the market
wg-underground-verb-close = Close the market
wg-underground-verb-arm = Arm the turrets
wg-underground-verb-disarm = Stand the turrets down
wg-underground-verb-payroll = Pay the crew ({$amount} thalers each)
wg-underground-verb-hop = Jump the station
wg-underground-verb-vendetta = Declare a vendetta on {$ship}

wg-underground-status = Heat: {$level}, {$percent}% of the way to a raid. Our smuggling crates fetch {$premium} times their price. Treasury: {$treasury} thalers. The market is {$market}.
wg-underground-reason-quiet = quiet-trade bonus
wg-underground-reason-hot = running hot
wg-underground-reason-lockdown = lockdown
wg-underground-status-open = open
wg-underground-status-closed = closed
wg-underground-status-lockdown = locked down
wg-underground-pass-issued = A market pass is ready. It lasts 30 minutes.
wg-underground-pass-wait = The next pass is ready in {$seconds} seconds.
wg-underground-pass-closed = The market is closed. Open it to issue passes.
wg-underground-payroll-paid = The Godfather has paid {$count} of us {$amount} thalers each.
wg-underground-payroll-failed = The crew can't be paid. Nobody is awake, or the treasury is short.
wg-underground-vendetta-declared = The Underground has declared a vendetta on {$ship} for {$minutes} minutes.

# Ship jammer
wg-ship-jammer-on = The jammer is on. No radio leaves this ship for {$minutes} minutes.
wg-ship-jammer-already = The jammer is already on.
wg-ship-jammer-no-grid = It needs a ship or a station under it to jam.
wg-ship-jammer-examine = It is jamming. It burns out in {$minutes} minutes.
wg-ship-jammer-spent = The jammer burns out.

# Uplink
wg-uplink-ship-jammer-name = Ship Jammer
wg-uplink-ship-jammer-desc = Switch it on aboard a ship and nobody on it can radio for help for ten minutes. It works once.

# Round end
wg-underground-round-end-header = [color=#991111][bold]The Underground[/bold][/color]
wg-underground-round-end-jobs = Sold {$jobs} jobs and took {$earned} thalers. The treasury ended on {$treasury}.
wg-underground-round-end-heat = Heat peaked at {$level}. {$captures} handed in to the TSF, {$bail} thalers of bail paid.
