light_mode unshaded;

uniform highp vec2 shuntCenter;
uniform highp vec2 shuntDirection;
uniform highp float shuntConcentration;
uniform highp float shuntCosHalfArc;
uniform highp float shuntBoost;
uniform highp float shimmerStrength;

void fragment() {
    highp vec2 offset = UV - shuntCenter;
    highp float alignment = clamp(dot(offset, shuntDirection) / max(length(offset), 0.00001), -1.0, 1.0);
    highp float inside = step(shuntCosHalfArc, alignment);
    highp float strength = mix(1.0 - shuntConcentration, shuntBoost, inside);
    if (strength <= 0.0) {
        discard;
    }
    highp float sweep = 0.0;
    highp float glint = 0.0;
    if (shimmerStrength > 0.0) {
        sweep = sin(UV.x * 0.7 + UV.y * 0.4 - TIME * 2.0);
        glint = sin(UV.x * 2.1 - UV.y * 1.3 + TIME * 4.0);
    }
    highp float shimmer = mix(1.0, 0.85 + 0.25 * sweep + 0.10 * glint, shimmerStrength);
    highp float brightness = 1.0 + 0.10 * min(max(strength - 1.0, 0.0), 4.0);
    COLOR = vec4(vec3((1.0 + 0.12 * sweep) * brightness), shimmer * min(strength, 3.0));
}
