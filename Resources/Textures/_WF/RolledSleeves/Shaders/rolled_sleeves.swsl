// Cuts a jumpsuit's sleeve below the elbow: mask alpha 0 removes the pixel, mask red lightens the cuff.
uniform sampler2D rollMask;
uniform highp vec4 rollMaskUV;

varying highp vec2 rollMaskUVOut;

void vertex() {
    rollMaskUVOut = mix(rollMaskUV.xy, rollMaskUV.zw, tCoord2);
}

void fragment() {
    highp vec4 mask = texture2D(rollMask, rollMaskUVOut);
    COLOR = zTexture(UV);
    COLOR.rgb = mix(COLOR.rgb, COLOR.rgb + (vec3(1.0) - COLOR.rgb) * 0.25, mask.r);
    COLOR.a *= mask.a;
}
